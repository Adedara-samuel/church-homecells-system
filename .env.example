# ---------------------------------------------------------------------------
# Church Homecell Management System — environment configuration
#
# Copy to `backend/.env` (and `frontend/.env.local` for the NEXT_PUBLIC_* values).
# Never commit a file containing real credentials.
#
# The application runs fully without any third-party credentials: payments, SMS and
# file uploads all fall back to built-in development providers. Supply the real
# credentials below to switch each integration over.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# A REPLICA SET is required in production: the financial ledger uses multi-document
# transactions. A standalone mongod works in development but degrades to sequential
# writes with compensating rollback.
MONGODB_URI=mongodb://127.0.0.1:27017/church_homecell
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/church_homecell?retryWrites=true&w=majority
MONGODB_DB_NAME=

# --- URLs ------------------------------------------------------------------
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Comma-separated list of origins permitted by CORS. No trailing slashes.
# An entry may contain '*' to match a single hostname label, which covers Vercel
# preview deployments:  https://church-homecells-system-frontend-*.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets MUST differ. The server refuses to start in production with defaults.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# --- Cloudinary (profile photographs, receipts, documents) -----------------
# Leave blank to store uploads on the local disk under backend/storage/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=church-homecell
UPLOAD_MAX_FILE_SIZE_MB=5

# --- Payments --------------------------------------------------------------
# PAYSTACK | FLUTTERWAVE | MOCK. The active provider is also configurable at runtime
# in Settings → Integrations; this value seeds it on first boot. A provider without
# credentials automatically falls back to MOCK.
PAYMENT_PROVIDER=MOCK
PAYMENT_CURRENCY=NGN

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Optional. Defaults to PAYSTACK_SECRET_KEY, which is what Paystack signs with.
PAYSTACK_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
# Required for Flutterwave: the "secret hash" configured in their dashboard.
FLUTTERWAVE_WEBHOOK_SECRET=

# --- SMS -------------------------------------------------------------------
# TERMII | TWILIO | MOCK
SMS_PROVIDER=MOCK
SMS_SENDER_ID=ChurchHC

TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Scheduled jobs --------------------------------------------------------
ENABLE_CRON_JOBS=true
CRON_TIMEZONE=Africa/Lagos
# Birthday and anniversary SMS — daily at 07:00
CELEBRATION_CRON=0 7 * * *
# Purse threshold sweep — hourly
THRESHOLD_CRON=0 * * * *
# Payment reconciliation — nightly at 01:30
RECONCILIATION_CRON=30 1 * * *
# "Attendance not submitted" reminders — 20:00 on Sunday, Tuesday and Thursday
ATTENDANCE_REMINDER_CRON=0 20 * * 0,2,4

# --- Seed ------------------------------------------------------------------
# Password assigned to every demo account by `npm run seed`. Change it before
# seeding anything that is reachable from outside your machine.
# QUOTE any value containing '#': dotenv treats an unquoted '#' as a comment and
# would silently truncate the password.
SEED_DEFAULT_PASSWORD="ChangeMe#2026"

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ---------------------------------------------------------------------------
# Must include the API prefix and carry NO trailing slash — a trailing slash builds
# request paths like '//auth/login', which the host redirects, and a redirect on a
# CORS preflight is rejected by the browser.
# Production example: https://church-homecells-system-backend.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Only used by the development mock-checkout page; must match JWT_ACCESS_SECRET.
NEXT_PUBLIC_MOCK_WEBHOOK_SECRET=dev-only-access-secret-change-me-please
