{
  "compilerOptions": {
    "target": "ES2022",
    // Node16 is the supported, non-deprecated setting for a Node CommonJS package
    // (the old "Node"/"node10" spelling is deprecated and stops working in TS 7).
    // With no "type": "module" in package.json every file stays CommonJS, so the
    // emitted output and all existing imports are unchanged.
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noImplicitOverride": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}